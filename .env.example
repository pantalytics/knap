# Knap MCP server -- standalone (single vault) configuration.
#
# Copy to .env and fill in. Nothing here has a guessed default: a missing vault
# path is a config error, because opening a directory nobody named is how you end
# up serving the wrong vault.

# ---- The vault -------------------------------------------------------------
# Absolute path to the vault directory (the folder holding .obsidian/).
KNAP_VAULT_PATH=/home/you/vaults/second-brain
# What the client calls it. Defaults to the directory name.
KNAP_VAULT_NAME=

# Backend. "filesystem" is the only one v1 ships.
KNAP_VAULT_PROVIDER=filesystem

# ---- Behaviour -------------------------------------------------------------
KNAP_MCP_LOG_LEVEL=INFO
# Page sizes for listing and search. A vault holds thousands of notes.
KNAP_MCP_DEFAULT_LIMIT=25
KNAP_MCP_MAX_LIMIT=100
# Reads truncate here; the client pages the rest with vault_read_chunk.
KNAP_MCP_MAX_BODY_CHARS=20000
# Ceiling on one attachment (bytes).
KNAP_MCP_MAX_ATTACHMENT_BYTES=10485760
# How many notes one search will open before it reports hitting the cap.
KNAP_MCP_MAX_SCAN_NOTES=20000

# ---- Transport -------------------------------------------------------------
# stdio for Claude Desktop / Claude Code; streamable-http for a container.
KNAP_MCP_TRANSPORT=stdio
KNAP_MCP_HOST=localhost
KNAP_MCP_PORT=8000
